public class App {
    public static abstract class Kendaraan {
        abstract void bergerak();

        abstract void info();
    }

    public static class Bus extends Kendaraan {
        @Override
        public void bergerak() {
            System.out.println("Bus bergerak dengan kecepatan sedang.");
        }

        @Override
        public void info() {
            System.out.println("Bus Kampus: Kapasitas besar, digunakan untuk transportasi mahasiswa");
        }
    }

    public static class Mobil extends Kendaraan {
        @Override
        public void bergerak() {
            System.out.println("Mobil bergerak dengan kecepatan tinggi.");
        }

        @Override
        public void info() {
            System.out.println("Mobil Pribadi: Kapasitas sedang, digunakan untuk operasional kampus");
        }

    }

    public static class Sepeda extends Kendaraan {
        @Override
        public void bergerak() {
            System.out.println("Sepeda bergerak dengan kecepatan rendah.");
        }

        @Override
        public void info() {
            System.out.println("Sepeda Listrik: Ramah lingkungan dan digunakan untuk jarak dekat di kampus");
        }

    }

    public static void main(String[] args) {

        // POLYMORPHISM: array dari tipe Kendaraan
        Kendaraan[] daftarKendaraan = new Kendaraan[4];

        daftarKendaraan[0] = new Bus();
        daftarKendaraan[1] = new Mobil();
        daftarKendaraan[2] = new Sepeda();

        // ANONYMOUS CLASS
        daftarKendaraan[3] = new Kendaraan() {
            @Override
            void bergerak() {
                System.out.println("Skuter listrik bergerak secara fleksibel di area kampus");
            }

            @Override
            void info() {
                System.out.println("Skuter Listrik: Kendaraan tambahan tanpa class khusus");
            }
        };

        // LOOPING (POLYMORPHISM TERJADI DI SINI)
        for (Kendaraan k : daftarKendaraan) {
            k.bergerak();
            k.info();
            System.out.println("----------------------");
        }
    }
}
